# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments & secrets ---
.env
.venv/
venv/
env/

# --- Runtime data: SQLite databases, secret_key, logs, backups, import artefacts ---
# Everything under instance/ is created and managed by the running app.
instance/
# Automatic daily database backups live OUTSIDE instance/ on purpose (they must
# survive a deleted/rebuild runtime folder), so they are ignored explicitly.
backups/
*.db
*.sqlite
*.sqlite3
*.log
errorlog.txt

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp

# Deployment secret (never commit a live webhook secret)
deploy_secret.txt

# Arena sandbox virtualenv
.venv-arena/
_audit/

# Local JS test dependency (jsdom) installed by npm
node_modules/

# --- PDF inspection scratch output (generated, never committed) ---
scratch/pdf_out/

# --- Local preview database (scratch, never committed) ---
scratch/preview.db*
scratch/preview.health.json

# --- Untracked 2026-11-07: files stay on disk, out of git (code-readability pass) ---
# Superseded legacy snapshots. AMS_SMOOTH_IMPORT.amsdb is deliberately NOT ignored:
# tests/test_services_master.py uses it as a fixture and skips when it is absent.
LEGACY DATA/AMS_FULL_*.amsdb
# Vendored sourcemaps (build by-products; browsers only fetch them in devtools)
static/vendor/**/*.map
# Generated audit outputs — regenerate with: python "checking tool/checkallapp.py"
checking tool/checkallapp_report.md
checking tool/checkallapp_results.json
# One-shot patch payloads (already applied; keep the folder's readme.md)
pending patches/*.patch
